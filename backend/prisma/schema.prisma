generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LECTURER
}

model User {
  id                String   @id // matches Supabase auth.users UUID
  firstName         String
  lastName          String
  email             String   @unique
  role              Role
  matricNumber      String?  @unique // Required for STUDENT
  staffId           String?  @unique // Required for LECTURER
  isVerified        Boolean  @default(true) // Set to true for now per user request
  isProfileComplete Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}